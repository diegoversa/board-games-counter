<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <!-- Background -->
  <rect width="512" height="512" rx="112" fill="#0a0a0a"/>
  <!-- Subtle gradient overlay -->
  <rect width="512" height="512" rx="112" fill="url(#bg)"/>
  <!-- Dice body -->
  <rect x="96" y="96" width="320" height="320" rx="64" fill="#1a1a1a"/>
  <rect x="96" y="96" width="320" height="320" rx="64" fill="url(#dicegrad)" opacity="0.6"/>
  <!-- Top shine -->
  <rect x="110" y="108" width="290" height="60" rx="30" fill="white" fill-opacity="0.05"/>
  <!-- Dots: 5 pattern -->
  <!-- top-left -->
  <circle cx="185" cy="185" r="36" fill="#ff4060"/>
  <circle cx="185" cy="185" r="28" fill="#ff6080"/>
  <!-- top-right -->
  <circle cx="327" cy="185" r="36" fill="#ff4060"/>
  <circle cx="327" cy="185" r="28" fill="#ff6080"/>
  <!-- center -->
  <circle cx="256" cy="256" r="36" fill="#e8c97a"/>
  <circle cx="256" cy="256" r="28" fill="#f0d890"/>
  <!-- bottom-left -->
  <circle cx="185" cy="327" r="36" fill="#40d090"/>
  <circle cx="185" cy="327" r="28" fill="#60e0a8"/>
  <!-- bottom-right -->
  <circle cx="327" cy="327" r="36" fill="#40d090"/>
  <circle cx="327" cy="327" r="28" fill="#60e0a8"/>
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a0008"/>
      <stop offset="50%" stop-color="#0a0a0a"/>
      <stop offset="100%" stop-color="#001a0a"/>
    </linearGradient>
    <linearGradient id="dicegrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </linearGradient>
  </defs>
</svg>
